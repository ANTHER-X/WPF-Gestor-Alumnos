<Window x:Class="Gestor_De_Alumnos.Window_See_Student.WndCreditos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gestor_De_Alumnos.Window_See_Student"
        ResizeMode="CanMinimize"
        x:Name="WNDCreditos"
        mc:Ignorable="d"
        Title="Creditos" Height="450" Width="300">
    
    <!-- Estilos de los controles -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Diccionarios-Recursos/ButtonsThemas.xaml"/>
                <ResourceDictionary Source="/Diccionarios-Recursos/LabelThemas.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Colores de fondo -->
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="1.1,0.4">
            <GradientStop Color="#FF74D65C"/>
            <GradientStop Color="#FFBE7F7F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        
        <!-- Logo o menu inicial (no tengo logo :v) -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Gestor de Alumnos" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" FontSize="22"/>
            <Label Name="LBVersion" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="26" FontFamily="Great Vibes"/>

        </Grid>

        <!-- Perfil -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Datos -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dev -->
                <Label Content="Developer:" Grid.Column="0" Grid.Row="0" Style="{StaticResource LBCredits}" Margin="2"/>
                <Label Content="Fernando Cisneros (Anther-X)" Grid.Column="1" Grid.Row="0" Style="{StaticResource LBCreditsData}" Margin="2"/>
                <!-- Email -->
                <Label Content="EMail:" Grid.Column="0" Grid.Row="1" Style="{StaticResource LBCredits}" Margin="2"/>
                <Label Content="fernandocisneroslemus@gmail.com" Grid.Column="1" Grid.Row="1" Style="{StaticResource LBCreditsData}" Margin="2"/>

            </Grid>
            
            <!-- Botones de acciones para el Email -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Copy Mail" Grid.Column="0" Click="Copy_Email_Click" Style="{StaticResource BTNCreditosMail}" Margin="24,4"/>
                <Button Content="Send Mail" Grid.Column="1" Click="Send_Email_Click" Style="{StaticResource BTNCreditosMail}" Margin="24,4"/>

            </Grid>

            <!-- Botones de contacto -->
            <Button Content="GitHub" Grid.Row="2" Click="OpenGitHub_Click" Style="{StaticResource BTNCreditos}" Margin="14,2"/>
            <Button Content="Instagram" Grid.Row="3" Click="Instagram_Click" Style="{StaticResource BTNCreditos}" Margin="14,2"/>
        </Grid> 

        <!-- Agregamos las herramientas asi como recursos con los que trabajamos -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Herramientas que se usan -->
            <GroupBox Header="Herramientas" Grid.Row="0">
                <UniformGrid Columns="2">
                    <TextBlock Text="• C#"/>
                    <TextBlock Text="• SQLCipher"/>
                    <TextBlock Text="• WPF"/>
                    <TextBlock Text="• ClosedXML"/>
                    <TextBlock Text="• Entity Framework Core"/>
                    <TextBlock Text="• SQLite"/>
                </UniformGrid>
            </GroupBox>
            
            <!-- Recursos usados de terceros -->
            <GroupBox Header="FlatIcon" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding CreditosList, ElementName=WNDCreditos}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            
                            <Grid DataContext="{Binding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="{Binding Resource}" Grid.Column="0"/>
                                <TextBlock Text="{Binding Author}" Grid.Column="1"/>
                                <Button Content="Abrir" Click="OpenCreditsURL_Click" Tag="{Binding URL}" Grid.Column="2" Margin="2">
                                    <Button.Background>
                                        <LinearGradientBrush >
                                            <GradientStop Color="#FFD99371"/>
                                            <GradientStop Color="#FFC1D993" Offset="0.7"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
            
            <!-- Boton de salir -->
            <Button Content="Salir" Click="Exit_Click" Grid.Row="2" Height="20" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button.Background>
                    <LinearGradientBrush >
                        <GradientStop Color="#FF0D9315"/>
                        <GradientStop Color="#FF4DADD4" Offset="0.7"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

        </Grid>

    </Grid>
</Window>
