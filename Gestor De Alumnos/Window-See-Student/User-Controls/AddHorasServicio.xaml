<UserControl x:Class="Gestor_De_Alumnos.Window_See_Student.User_Controls.AddHorasServicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gestor_De_Alumnos.Window_See_Student.User_Controls"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Height="230" Width="310">

    <!-- Cargamos los recursos para el Front de los controles -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Gestor De Alumnos;component/Diccionarios-Recursos/ButtonsThemas.xaml"/>
                <ResourceDictionary Source="/Gestor De Alumnos;component/Diccionarios-Recursos/TextBoxThemas.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <!-- Le damos un color degradado al UserControl -->
    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF61C8EB"/>
            <GradientStop Color="#FFCC72E6" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <StackPanel>

            <Grid Height="40">

                <Label Name="LBStudentData" Content="Alumno: Grupo + Nombre + Apellidos" HorizontalContentAlignment="Center" Height="30" FontSize="16"/>

            </Grid>

            <Grid Height="64">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Label Name="LBActualHoras" Content="AnidarHoras" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Grid.Row="0" Height="31" Margin="10,0,10,0"/>
                <TextBox Name="TXBHoras" Style="{StaticResource TextBoxLlamativoSuave}" PreviewTextInput="TXBHoras_PreviewTextInput" Text="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Grid.Row="1" Height="29"/>

            </Grid>

            <Grid Height="50">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Button Name="BTNAdd" Style="{StaticResource ButtonAnidaHoras}" Click="BTNAdd_Click" Content="ADD" Width="145" Height="25" Margin="4" Grid.Column="0"/>
                <Button Name="BTNDelete" Style="{StaticResource ButtonAnidaHoras}" Click="BTNDelete_Click" Content="Quitar Hora(s)" Width="145" Height="25" Margin="3" Grid.Column="1"/>

            </Grid>

            <Grid Height="50">
                <Button Name="BTNSalir" Style="{StaticResource ButtonAnidaHoras}" Click="BTNSalir_Click" Content="Salir" Width="290" Height="28" Margin="6"></Button>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
