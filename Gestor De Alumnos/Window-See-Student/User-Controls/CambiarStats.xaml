<UserControl x:Class="Gestor_De_Alumnos.Window_See_Student.User_Controls.CambiarStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gestor_De_Alumnos.Window_See_Student.User_Controls"
             mc:Ignorable="d" Height="444" Width="596" Loaded="UserControl_Loaded">

    <!-- Fondo del control -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
            <GradientStop Color="#FF744EDF" Offset="0.12"/>
            <GradientStop Color="#FFBF52EE" Offset="0.63"/>
            <GradientStop Color="#FF568AA7" Offset="1.04"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <!-- Cargamos los estilos y themas que usaremos en los controles -->
    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Gestor De Alumnos;component/Diccionarios-Recursos/TextBoxThemas.xaml"/>
                <ResourceDictionary Source="/Gestor De Alumnos;component/Diccionarios-Recursos/ButtonsThemas.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <!-- Definimos un grid con 2 filas -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="210"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- LA primera fila contara con los controles de datos personales y la foto del sujeto -->
        <Grid Grid.Row="0">

            <!-- Dividimos 2 columnas para los datos y las fotos -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- Agregamos el lado de los datos personales -->
            <GroupBox Header="Personal Data" Grid.Column="1" Margin="2">

                <Grid>
                    
                    <!-- Acomodamos los controles para que tengan un size de altura de 36 pixeles-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    
                    <Label Content="Nombre" FontSize="13" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="0" Margin="5"/>
                    <TextBox Name="TXBNombre" Style="{StaticResource RetroTextBox}" VerticalContentAlignment="Center" FontSize="14" HorizontalContentAlignment="Center" Grid.Column="1" Grid.Row="0" Margin="5"/>


                    <Label Content="Apellidos" FontSize="13" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="1" Margin="5"/>
                    <TextBox Name="TXBApellidos" Style="{StaticResource RetroTextBox}" VerticalContentAlignment="Center" FontSize="14" HorizontalContentAlignment="Center" Grid.Column="1" Grid.Row="1" Margin="5"/>


                    <Label Content="Num. Tel. (+52)" FontSize="13" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="2" Margin="5"/>
                    <TextBox Name="TXBTelefono" Style="{StaticResource RetroTextBox}" PreviewKeyDown="TXBPreviewKeyDown" TextChanged="TXBTelefono_TextChanged" PreviewTextInput="TXBTelefono_PreviewTextInput" VerticalContentAlignment="Center" FontSize="14" HorizontalContentAlignment="Center" Grid.Column="1" Grid.Row="2" Margin="5"/>


                    <Label Content="F. Nac." FontSize="13" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="3" Margin="5"/>
                    <DatePicker Name="DTPKFechaNacimiento" Grid.Column="1" Grid.Row="3" Margin="5"/>

                </Grid>

            </GroupBox>

            <!-- Agregamos la foto -->
            <GroupBox Header="Imagen Alumno" Grid.Column="0" Margin="2">

                <GroupBox.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFF4E2E2"/>
                        <GradientStop Color="#FFD1304D" Offset="1.24"/>
                    </RadialGradientBrush>
                </GroupBox.Background>

                <Grid>

                    <Button Name="BTNCambiaImagen" Style="{StaticResource BotonSuave}" Click="BTNCambiaImagen_Click" Content="Cambia Imagen" HorizontalAlignment="Center" Margin="0,157,0,0" VerticalAlignment="Top" Width="110"/>
                    <Image Name="IMGCambiaImagen" Margin="10,10,9,0" VerticalAlignment="Top" Height="136"/>

                </Grid>

            </GroupBox>
        </Grid>

        <!-- En la segunda fila del grid padre dividimos para montar 2 listas aparte -->
        <Grid Grid.Row="1">

            <!-- En la primera fila del grid montamos los datos escolares del alumno -->
            <GroupBox Header="School Data" Margin="2">

                <Grid>

                    <!-- Subdividimos 2 filas mas para poner 6 datos en la fila 1, un dato y un logo en la fila 2-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En la fila 1 sibdividimos para poner los datos-->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Subdividimos los controles para que tengan una altura de 36 pixeles -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- Agregamos los controles en sus respectivos espacios -->
                        <Label Content="Capacitacion" FontSize="14" HorizontalContentAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox Name="TXBCapac" Style="{StaticResource RetroTextBox}" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="1" Margin="5"/>

                        <Label Content="Grupo" FontSize="14" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox Name="TXBGrupo" Style="{StaticResource RetroTextBox}" PreviewTextInput="TXBGrupo_PreviewTextInput" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="5"/>

                        <Label Content="Bachillerato" FontSize="14" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBox Name="TXBBach" Style="{StaticResource RetroTextBox}" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Margin="5"/>


                        <Label Content="Matricula" FontSize="14" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="2" Margin="5"/>
                        <TextBox Name="TXBMatricula" Style="{StaticResource RetroTextBox}" PreviewTextInput="TXBMatricula_PreviewTextInput" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="3" Margin="5"/>

                        <Label Content="Club" FontSize="14" HorizontalContentAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="5"/>
                        <TextBox Name="TXBClub" Style="{StaticResource RetroTextBox}" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="3" Margin="5"/>

                        <Label Content="Turno" FontSize="14" HorizontalContentAlignment="Center" Grid.Row="2" Grid.Column="2" Margin="5"/>
                        <TextBox Name="TXBTurno" Style="{StaticResource RetroTextBox}" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="3" Margin="5"/>

                    </Grid>

                    <!-- En la 2 ponemos el 7mo dato y el logo -->
                    <Grid Grid.Row="1">

                        <!-- Hacemos columnas para mas controles de datos y para los botones de acciones -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- en la primer columna agregamos los controles de datos -->
                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>
                                <!-- Altura adecuada para los controles, lo demas sera para otras cosas -->
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Para agregar contoles de datos -->
                            <Grid Grid.Row="0">

                                <!-- Mas subdiviciones para dejar un size de acuerdo a los demas-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Controles -->
                                <Label Name="LBHorasServProf" Content="ProfSevSoc" FontSize="14" HorizontalContentAlignment="Center" Grid.Column="0" Margin="5"/>
                                <TextBox Name="TXBProf" Style="{StaticResource RetroTextBox}"  FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="1" Margin="5"/>

                            </Grid>
                            
                            <!-- Para agregar controles esteticos -->
                            <Grid Grid.Row="1">
                                <Viewbox Stretch="Fill" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" Width="180" Height="50">
                                    <TextBlock Text="ANTHER-X" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F04EE583" Margin="2" TextBlock.FontSize="36" TextBlock.FontFamily="Segoe Script" FontWeight="Bold"/>
                                </Viewbox>
                            </Grid>

                        </Grid>

                        <StackPanel Grid.Column="1">

                            <!-- Retocamos un poco the size of buttons and the margin-->
                            <Button Name="BTNChangeStats" Click="BTNChangeStats_Click" Style="{StaticResource BotonSuave}" Content="Cambiar Estadisticas" FontSize="17" HorizontalContentAlignment="Center" Height="26" Margin="2"/>
                            <Button Name="BTNExit" Click="BTNExit_Click" Style="{StaticResource BotonSuave}" Content="Salir" FontSize="17" HorizontalContentAlignment="Center" Height="26" Margin="2"/>
                            <Button Name="BTNResetStudent" Content="Refrescar" Style="{StaticResource BotonSuave}" Click="BTNResetStudent_Click" FontSize="17" HorizontalContentAlignment="Center" Height="26" Margin="2"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</UserControl>
