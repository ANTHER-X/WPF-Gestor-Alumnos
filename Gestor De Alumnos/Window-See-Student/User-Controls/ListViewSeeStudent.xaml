<UserControl x:Class="Gestor_De_Alumnos.Window_See_Student.User_Controls.ListViewSeeStudent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gestor_De_Alumnos.Window_See_Student.User_Controls"
             mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Gestor de Alumnos;component/Diccionarios-Recursos/TextBoxThemas.xaml"/>
                <ResourceDictionary Source="/Gestor de Alumnos;component/Diccionarios-Recursos/LabelThemas.xaml"/>
                <ResourceDictionary Source="/Gestor de Alumnos;component/Diccionarios-Recursos/ButtonsThemas.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:ReescrituraRutaImagenAlumno x:Key="ReescribirRuta"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nombre -->
            <Label Name="LBNombre"  Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="0" Height="40" Width="165">
                <TextBlock>
                                    Nombre: <Run Text="{Binding name, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Apellidos -->
            <Label Name="LBApellidos" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="1" Height="40" Width="165">
                <TextBlock>
                                    Apellidos: <Run Text="{Binding apellidos, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Fecha de Nacimiento -->
            <Label Name="LBFechNac" Style="{StaticResource LabelGrupoVisor}" Grid.Column="1" Grid.Row="0" Height="40" Width="165">
                <TextBlock>
                                    Fecha de Nacimiento: 
                                    <LineBreak/>
                                    <Run Text="{Binding fechaNacimiento, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Edad -->
            <Label Name="LBEdad" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="1" Height="40" Width="165">
                <TextBlock>
                                    Edad: <Run Text="{Binding edad, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Telefono -->
            <Label Name="LBTelefono" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="2" Height="40" Width="165">
                <TextBlock>
                                    Telefono (+52): <Run Text="{Binding Telefono, Mode=OneWay}"/>
                </TextBlock>
            </Label>


            <!-- Grupo -->
            <Label Name="LBGrupo" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" Grid.Column="1" Grid.Row="2" Height="40" Width="165">
                <TextBlock>
                                    Grupo:  <Run Text="{Binding grupo, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Matricula -->
            <Label Name="LBMatricula" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="3" Height="40" Width="165">
                <TextBlock>
                                    Matricula: <Run Text="{Binding Matricula, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Turno -->
            <Label Name="LBTurno" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="3" Height="40" Width="165">
                <TextBlock>
                                    Turno: <Run Text="{Binding turno, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Capacitacion -->
            <Label Name="LBCapacit" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" Grid.Row="3" Height="40" Width="165">
                <TextBlock>
                                    Capacitacion: <Run Text="{Binding capacitacion, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Bachillerato -->
            <Label Name="LBBach" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" Grid.Row="2" Height="40" Width="165">
                <TextBlock>
                                    Bachillerato: 
                                    <LineBreak/>
                                    <Run Text="{Binding bachillerato, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Club -->
            <Label Name="LBClub" Style="{StaticResource LabelGrupoVisor}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" Grid.Row="1" Height="40" Width="165">
                <TextBlock>
                                    Club: <Run Text="{Binding club, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Profesor de Servicio Social -->
            <Label Name="LBProfServSoc" Style="{StaticResource LabelGrupoVisor}" Grid.Column="2" Grid.Row="0" Height="40" Width="165">
                <TextBlock>
                                    Profesor Que Libera Horas:
                                    <LineBreak/>
                                    <Run Text="{Binding profServSoc, Mode=OneWay}"/>
                </TextBlock>
            </Label>

        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Horas de servicio Social -->
            <Label Name="LBHorasServ" Style="{StaticResource LabelGrupoVisor}" Grid.Row="0" Height="40" Width="165">
                <TextBlock>
                                    Horas De Servicio Social: 
                                    <LineBreak/>
                                    Total Hours: <Run Text="{Binding horasServicioSocial, Mode=OneWay}"/>
                </TextBlock>
            </Label>

            <!-- Foto del alumno, le damos un fondo degradado para verse mejor -->
            <GroupBox Header="Foto" FontSize="10" Grid.Row="1">

                <GroupBox.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFDFCFC"/>
                        <GradientStop Color="#FF61C8EB" Offset="1.24"/>
                    </RadialGradientBrush>
                </GroupBox.Background>

                <GroupBox.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#584894"/>
                        <GradientStop Color="#4CA8E0" Offset="1"/>
                    </LinearGradientBrush>
                </GroupBox.BorderBrush>

                <!-- Cargamos la ruta y tambien usamos nuestra clase para darle el formato correcto a la ruta -->
                <Image Name="IMGAlumno" Source="{Binding RutaImagen, Converter={StaticResource ReescribirRuta}}" Height="100" Width="75"/>
            </GroupBox>

        </Grid>

        <Grid Grid.Column="2">

            <Button Name="BTNModificaAlumno" Click="BTNModificaAlumno_Click" Margin="15,0,0,0" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Height="0" Width="0" Style="{StaticResource ButtonDegradadoPastelColor}">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                                    Modificar Alumno
                </TextBlock>
            </Button>

        </Grid>

    </Grid>
</UserControl>
