<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Estilo colorido para los Label del visor de grupos -->
    <Style TargetType="Label" x:Key="LabelGrupoVisor">
        <!-- Parametros base -->
        <Setter Property="BorderBrush" Value="#584894"/>
        <Setter Property="Background" Value="#4CA8E0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="2.4"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>

        <!-- Tocamos su plantilla para manipular sus acciones -->
        <Setter Property="Template">
            <Setter.Value>
                <!-- Dejamos los estilos que le pusimos asi como la forma de presentacion del texto -->
                <ControlTemplate TargetType="Label">
                    <Border CornerRadius="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            RecognizesAccessKey="True"/>
                    </Border>
                    
                    <!-- Si el raton pasa por el, cambiamos el color de fonndo -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#6F55CF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>


    </Style>

</ResourceDictionary>